{
  "name": "mandarin-lens",
  "version": "2.1.1",
  "private": true,
  "description": "Local-first Mandarin learning subtitles for desktop Chrome",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "simulate": "node tests/simulate.cjs",
    "test:browser": "node tests/browser.cjs",
    "build": "python3 scripts/package.py",
    "check": "node scripts/check.cjs",
    "test:model": "node tests/real-model.cjs",
    "test:real-extension": "node tests/real-extension.cjs",
    "site": "python3 scripts/site.py",
    "test:sites": "npm run build && node tests/site-prompt.cjs",
    "test:youtube": "npm run build && node tests/youtube-captions.cjs"
  }
}
